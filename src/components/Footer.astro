---
import { SITE, SOCIALS } from "@config";

const currentYear = new Date().getFullYear();
const socials = SOCIALS.filter(social => social.active);

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`${noMarginTop ? "" : "mt-auto"}`}>
  <div class="footer-wrapper">
    <span class="copyright">© {currentYear} {SITE.title}</span>
    <ul class="footer-links">
      {
        socials.map(social => (
          <li>
            <a href={social.href} title={social.linkTitle}>
              {social.name.toLowerCase()}
            </a>
          </li>
        ))
      }
      <li><a href="/rss.xml" title="RSS feed">rss</a></li>
    </ul>
  </div>
</footer>

<style>
  footer {
    @apply mx-auto w-full max-w-4xl px-4;
  }
  .footer-wrapper {
    @apply flex flex-col items-center gap-3 border-t border-skin-line py-6 text-xs opacity-70 sm:flex-row sm:justify-between;
  }
  .footer-links {
    @apply flex gap-4;
  }
  .footer-links a {
    @apply hover:text-skin-accent;
  }
</style>
