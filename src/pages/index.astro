---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import ProjectCard from "@components/ProjectCard.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";

const posts = await getCollection("blog");
const latestPosts = getSortedPosts(posts).slice(0, 4);

const featuredProjects = (await getCollection("project"))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <div class="hero-copy">
        <h1>Mobile engineer.<br />Indie app maker.</h1>
        <p>
          I've spent years in the Apple ecosystem, from Objective-C to Swift and
          TDD. Now I write about it here and ship my own apps for iOS and
          Android.
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn btn-primary">See the apps</a>
          <a href="/posts" class="btn">Read the blog</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-glow"></div>
        <img
          src="/metro/ios-map.jpg"
          alt=""
          width="200"
          height="434"
          class="hero-phone"
        />
      </div>
    </section>

    <section id="apps">
      <div class="section-head">
        <h2>Apps</h2>
        <a href="/projects">all projects →</a>
      </div>
      <ul class="app-grid">
        {featuredProjects.map(({ data }) => <ProjectCard project={data} />)}
      </ul>
    </section>

    <section id="writing">
      <div class="section-head">
        <h2>Latest writing</h2>
        <a href="/posts">all posts →</a>
      </div>
      <ul class="post-grid">
        {
          latestPosts.map(({ data }) => (
            <Card
              href={`/posts/${slugify(data)}`}
              frontmatter={data}
              secHeading={false}
            />
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto flex w-full max-w-4xl flex-col gap-16 px-4 pb-16 pt-8 sm:gap-20 sm:pt-14;
  }
  #hero {
    @apply grid items-center gap-10 sm:grid-cols-[minmax(0,1fr)_300px];
  }
  .hero-copy {
    @apply flex flex-col gap-5;
  }
  #hero h1 {
    @apply text-4xl font-bold leading-[1.05] sm:text-6xl;
  }
  #hero p {
    @apply max-w-lg leading-relaxed opacity-80;
  }
  .hero-actions {
    @apply flex flex-wrap gap-3 pt-1;
  }
  .btn {
    @apply rounded-[10px] border border-skin-line px-5 py-3 font-display text-sm font-medium hover:border-skin-accent hover:text-skin-accent;
  }
  .btn-primary {
    @apply border-skin-accent bg-skin-accent font-bold text-skin-inverted hover:text-skin-inverted hover:opacity-90;
  }
  .hero-visual {
    @apply relative hidden items-center justify-center sm:flex;
    height: 420px;
  }
  .hero-glow {
    @apply absolute h-72 w-72 rounded-full;
    background: radial-gradient(
      circle,
      rgba(var(--color-accent), 0.28),
      rgba(var(--color-accent), 0) 70%
    );
  }
  .hero-phone {
    @apply relative w-[200px] -rotate-3 rounded-[28px] border-[6px] border-skin-line shadow-2xl;
  }
  .section-head {
    @apply mb-5 flex items-baseline justify-between;
  }
  .section-head h2 {
    @apply text-2xl font-bold sm:text-[26px];
  }
  .section-head a {
    @apply text-sm opacity-70 hover:text-skin-accent hover:opacity-100;
  }
  .app-grid {
    @apply grid gap-4 sm:grid-cols-2;
  }
</style>
